{
  "name": "motion-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "timeline": "node ../scripts/storyboard_to_timeline.mjs storyboard.json",
    "still": "remotion still Main out/still.png --frame=30",
    "draft": "remotion render Main out/draft.mp4 --scale=0.5 --jpeg-quality=60",
    "render": "remotion render Main out/master.mp4 --codec=h264 --crf=18",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@remotion/cli": "4.0.537",
    "@remotion/fonts": "4.0.537",
    "@remotion/media": "4.0.537",
    "@remotion/transitions": "4.0.537",
    "animejs": "4.5.0",
    "gsap": "3.15.0",
    "mediabunny": "1.61.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "typescript": "5.9.3"
  }
}

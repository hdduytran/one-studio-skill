{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "one-studio/storyboard.schema.json",
  "title": "one-studio storyboard",
  "description": "Scene list in playback order. Scene ids are stable: renaming an id discards its cache.",
  "type": "object",
  "required": [
    "version",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "worlds": {
      "type": "object",
      "description": "Shared canvases in worlds/<name>.html; scenes that name one render as camera moves inside it.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "file",
          "size"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "size": {
            "type": "object",
            "required": [
              "w",
              "h"
            ],
            "additionalProperties": false,
            "properties": {
              "w": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "motifs": {
      "type": "array",
      "description": "Recurring objects that carry across scenes (match cuts, running motif).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "selector"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "sceneType": {
      "enum": [
        "text",
        "diagram",
        "data",
        "lottie",
        "rive",
        "explainer",
        "character",
        "3d",
        "screen"
      ]
    },
    "engine": {
      "enum": [
        "hyperframes",
        "remotion",
        "lemo"
      ]
    },
    "line": {
      "description": "One spoken sentence. One TTS call and one caption cue per line.",
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Caption text (digits allowed)."
        },
        "say": {
          "type": "string",
          "description": "What TTS speaks when it differs from text (numbers spelled out)."
        },
        "lang": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "pause_after": {
          "type": "number",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "fact",
            "quote",
            "opinion",
            "narration"
          ]
        },
        "source": {
          "description": "Research item id(s) backing this line.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "speaker": {
          "type": "string",
          "description": "Who said it, for kind=quote."
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "cut",
            "fade",
            "slide-left",
            "slide-up",
            "wipe",
            "zoom",
            "blur"
          ]
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "type",
        "duration"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/sceneType"
        },
        "engine": {
          "$ref": "#/$defs/engine",
          "description": "Override; default comes from the type: character→lemo, 3d→hyperframes (three.js) unless three.physics or three.postfx → remotion, everything else→hyperframes."
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Planned seconds; extended to fit VO in phase 5."
        },
        "goal": {
          "type": "string",
          "description": "What the viewer must take away from this scene."
        },
        "visual": {
          "type": "string",
          "description": "What is on screen, in a sentence or two."
        },
        "layout": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "sfx": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sfxCue"
          },
          "description": "Sound effects for this scene (scene-relative)."
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths relative to the project."
        },
        "transition": {
          "$ref": "#/$defs/transition"
        },
        "notes": {
          "type": "string"
        },
        "data": {
          "description": "Inline data for type=data (chart rows).",
          "type": [
            "array",
            "object"
          ]
        },
        "explainer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "object": {
              "type": "string",
              "description": "The physical machine that embodies the concept."
            },
            "size": {
              "enum": [
                "figure",
                "hero"
              ]
            },
            "theme": {
              "enum": [
                "dark",
                "light"
              ]
            }
          }
        },
        "character": {
          "type": "object",
          "required": [
            "style"
          ],
          "additionalProperties": false,
          "properties": {
            "style": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$",
              "description": "lemo-opuscar styles/<slug>."
            },
            "action": {
              "type": "string"
            }
          }
        },
        "screen": {
          "type": "object",
          "required": [
            "flow"
          ],
          "additionalProperties": false,
          "description": "Screen scene: plays a recorded flow (flows/<id>.json, capture-screen.mjs) between two marks.",
          "properties": {
            "flow": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "from_mark": {
              "type": "string",
              "description": "Start at this mark (default: start of the recording)."
            },
            "to_mark": {
              "type": "string",
              "description": "End at this mark (default: end of the recording)."
            },
            "frame": {
              "enum": [
                "window",
                "device",
                "none"
              ],
              "description": "Window chrome around the recording (default window)."
            },
            "zoom": {
              "enum": [
                "auto",
                "manual"
              ],
              "description": "auto: the camera follows clicks; manual: no zoom unless the scene script adds one."
            },
            "cursor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {
                  "type": "number",
                  "minimum": 8,
                  "maximum": 120,
                  "description": "Pointer height in scene px at 1080 on the short side."
                },
                "smooth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "0 = raw recorded path, 1 = very soft spring (default 0.5)."
                }
              }
            }
          }
        },
        "three": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subject": {
              "type": "string"
            },
            "camera": {
              "type": "string"
            },
            "physics": {
              "type": "boolean",
              "description": "Needs a physics engine (Rapier): renders with Remotion + R3F."
            },
            "postfx": {
              "type": "boolean",
              "description": "Needs post-processing (bloom, DOF…): renders with Remotion + R3F."
            }
          }
        },
        "mode": {
          "$ref": "#/$defs/visualMode",
          "description": "Staging style; see writers-room/visual-modes. Not a scene type."
        },
        "world": {
          "type": "string",
          "description": "Key of root worlds."
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/cameraTarget"
            },
            "to": {
              "$ref": "#/$defs/cameraTarget"
            },
            "move": {
              "enum": [
                "cut",
                "push",
                "fly",
                "orbit",
                "follow"
              ]
            },
            "ease": {
              "type": "string"
            },
            "at": {
              "type": "number",
              "minimum": 0
            },
            "dur": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "exit_state": {
          "type": "object",
          "description": "World element id to state name at the end of the scene.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "enter_state": {
          "type": "object",
          "description": "World element id to state name at the start of the scene. Defaults to the exit_state of the previous scene in the same world.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "handoff": {
          "type": "object",
          "required": [
            "selector",
            "to_scene"
          ],
          "additionalProperties": false,
          "properties": {
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "to_scene": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "motion": {
          "enum": [
            "smooth",
            "stepped-12"
          ]
        },
        "motif": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": "Ids from root motifs shown in this scene."
        }
      }
    },
    "sfxCue": {
      "description": "One sound effect placed relative to the scene start (or to the start of `line`). Mixed by concat-and-mix; never part of the picture.",
      "type": "object",
      "required": [
        "at"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "src"
          ]
        }
      ],
      "properties": {
        "name": {
          "enum": [
            "whoosh",
            "swoosh",
            "pop",
            "click",
            "ding",
            "riser",
            "impact"
          ],
          "description": "Built-in offline SFX (make-sfx.mjs)."
        },
        "src": {
          "type": "string",
          "description": "Audio file relative to the project instead of a built-in."
        },
        "at": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds from the scene start, or from the start of `line`."
        },
        "line": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Anchor to a storyboard line id (its VO start, from audio/manifest.json)."
        },
        "gain": {
          "type": "number",
          "minimum": -60,
          "maximum": 12,
          "description": "dB, default 0."
        }
      }
    },
    "visualMode": {
      "enum": [
        "world-camera",
        "match-cut-motif",
        "screen-cinema",
        "desk-collage",
        "exploded-cutaway",
        "kinetic-type",
        "split-compare",
        "archive-documents",
        "data-story-motion"
      ]
    },
    "cameraTarget": {
      "description": "A place id in the world, or a free position.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "zoom": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    }
  }
}
